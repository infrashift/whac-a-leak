---
// Landing page: not managed by Starlight.
import { Image } from 'astro:assets';
import '../styles/landing.css';
import logo from '../assets/whac-a-leak.jpeg';

// A real layer (docs/src/demo/rule.cue) and the output of a real scan with it.
// `make docs-demo` regenerates scan-output.txt by running whac on app.env;
// TestDocsDemoOutputIsCurrent fails when the file is stale.
import ruleSource from '../demo/rule.cue?raw';
import scanOutput from '../demo/scan-output.txt?raw';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const repo = 'https://github.com/infrashift/whac-a-leak';

const esc = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');

// Light CUE highlighting, one line at a time: comments, strings, field labels.
// Scan output: severity and rule ID stand out; fingerprints are muted.
const scanHtml = scanOutput
	.trimEnd()
	.split('\n')
	.map((line) => {
		const head = /^(CRITICAL|HIGH|MEDIUM|LOW)(\s+)(\S+)(\s+)(.*)$/.exec(line);
		if (head) {
			return `<span class="finding">${head[1]}</span>${head[2]}<span class="rule">${esc(head[3])}</span>${head[4]}${esc(head[5])}`;
		}
		if (/^\s+fingerprint:/.test(line)) return `<span class="cmt">${esc(line)}</span>`;
		return esc(line);
	})
	.join('\n');

const ruleHtml = ruleSource
	.trimEnd()
	.split('\n')
	.map((line) => {
		const c = line.indexOf('//');
		if (c !== -1 && !line.slice(0, c).includes('"')) {
			return `${esc(line.slice(0, c))}<span class="cmt">${esc(line.slice(c))}</span>`;
		}
		return esc(line).replace(
			/(#?"(?:[^"\\]|\\.)*"#?)|^(\s*)([A-Za-z_][A-Za-z0-9_]*)(:)|\b(package)\b/g,
			(m: string, str?: string, ws?: string, label?: string, colon?: string, kw?: string) => {
				if (str) return `<span class="str">${str}</span>`;
				if (label) return `${ws}<span class="${/^[A-Z0-9_]+$/.test(label) ? 'rule' : 'key'}">${label}</span>${colon}`;
				if (kw) return `<span class="kw">${kw}</span>`;
				return m;
			},
		);
	})
	.join('\n')
	// Nested labels such as `rules: ACME_API_TOKEN:` after the first label.
	.replace(/(<\/span>: )([A-Z0-9_]{3,})(:)/g, '$1<span class="rule">$2</span>$3');
---

<html lang="en" data-theme="dark">
<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1" />
	<title>Whac-a-Leak: Secret Scanner With CUE Rules</title>
	<meta name="description" content="Whac-a-Leak (whac) is a pure-Go secret scanner. CUE defines the rules, and each rule carries its own samples. A two-tier engine reads YAML, JSON and .env files as key paths." />
	<link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
</head>
<body>

<nav class="nav">
	<a href={base} class="nav-logo"><span class="prompt">&gt;</span> whac</a>
	<ul class="nav-links">
		<li><a href={`${base}docs/`}>Docs</a></li>
		<li><a href={`${base}docs/getting-started/`}>Quick Start</a></li>
		<li class="hide-sm"><a href={`${base}docs/project/decisions/`}>Design</a></li>
		<li class="hide-sm"><a href={`${base}docs/project/roadmap/`}>Roadmap</a></li>
		<li><a href={repo}>GitHub</a></li>
		<li><button class="theme-toggle" id="theme-toggle" aria-label="Toggle theme">&#9790;</button></li>
	</ul>
</nav>

<section class="hero">
	<Image
		src={logo}
		alt="Whac-a-Leak logo: a Go gopher at a whack-a-mole cabinet operates a robot with mallets. Keys, a padlock, a certificate, an API key, a token, a password and a .env file come out of the holes."
		class="mascot"
		width={1600}
		widths={[480, 800, 1200, 1600]}
		sizes="(max-width: 46rem) calc(100vw - 2rem), 44rem"
		format="webp"
		quality={80}
		loading="eager"
		fetchpriority="high"
	/>
	<div class="wordmark"><span class="prompt">&gt;</span> whac<span class="caret">_</span></div>
	<h1>Find secrets before they leak</h1>
	<p class="tagline">
		Whac-a-Leak is a secret scanner in pure Go. <strong>CUE</strong> defines its rules.
		Each rule has a type, organization layers and its own <strong>samples</strong>. If a sample fails, whac does not load the rules.
		The engine checks keywords first, then regex and entropy. It reads YAML, JSON and <code>.env</code> files as key paths.
	</p>
	<div class="hero-cta">
		<a href={`${base}docs/getting-started/`} class="btn btn-primary">Get Started</a>
		<a href={`${base}docs/project/decisions/`} class="btn btn-secondary">Design Decisions</a>
		<a href={repo} class="btn btn-ghost">GitHub &rarr;</a>
	</div>
</section>

<section class="install">
	<code>git clone {repo} &amp;&amp; cd whac-a-leak &amp;&amp; make build</code>
	<span class="note">
		Requires Go 1.25+ and git. Pre-alpha: ADRs record the design, and each milestone adds part of the scanner. <a href={`${base}docs/project/roadmap/`}>See the roadmap.</a>
	</span>
</section>

<section class="demo">
	<div class="demo-grid">
		<div class="terminal">
			<div class="terminal-bar">
				<span class="dot"></span><span class="dot"></span><span class="dot"></span>
				<span class="title">.whac/acme.cue &nbsp;·&nbsp; a rule with its own samples</span>
			</div>
			<pre set:html={ruleHtml}></pre>
		</div>
		<div class="terminal">
			<div class="terminal-bar">
				<span class="dot"></span><span class="dot"></span><span class="dot"></span>
				<span class="title">whac scan app.env &nbsp;·&nbsp; findings</span>
			</div>
			<pre class="wrap" set:html={scanHtml}></pre>
		</div>
	</div>
	<p class="demo-caption">
		Left: a layer with one rule. Right: the output of <code>whac scan</code> on a file with fake tokens. The placeholder token is not reported. whac produced this output.
	</p>
</section>

<section class="features">
	<h2>Why Whac-a-Leak?</h2>
	<div class="feature-grid">
		<div class="feature-card">
			<div class="icon">&#9989;</div>
			<h3>Rule Samples</h3>
			<p>Each rule has <code>mustMatch</code> and <code>mustIgnore</code> samples. The engine runs them at every load. If a sample fails, whac does not load the rules.</p>
		</div>
		<div class="feature-card">
			<div class="icon">&#129521;</div>
			<h3>Organization Layers</h3>
			<p>The binary contains the builtin rules. Layers in your <code>.whac/</code> config dir add rules, tighten rules, and disable or re-grade rules by ID. No fork is necessary.</p>
		</div>
		<div class="feature-card">
			<div class="icon">&#9889;</div>
			<h3>Two-Tier Engine</h3>
			<p>One Aho-Corasick pass selects the candidate rules. Only those rules run their regex and entropy checks. Pure Go, <code>CGO_ENABLED=0</code>, one static binary.</p>
		</div>
		<div class="feature-card">
			<div class="icon">&#128450;</div>
			<h3>Structured Files</h3>
			<p>whac reads YAML, JSON, <code>.env</code>, properties and HCL-style files as key paths. It finds a password at <code>database.credentials.password</code> with low entropy and no prefix.</p>
		</div>
		<div class="feature-card">
			<div class="icon">&#128273;</div>
			<h3>Fingerprint Allowlists</h3>
			<p>A <code>whac1:</code> fingerprint of the rule and the secret identifies each finding. It contains no file or line, so allowlist entries survive rebases.</p>
		</div>
		<div class="feature-card">
			<div class="icon">&#128270;</div>
			<h3>Files, History, Agents</h3>
			<p>Scan a directory, staged changes or the full git history. Audit the environment variables and credential files of an agent before it starts. Output: text, JSON or SARIF. No network calls.</p>
		</div>
	</div>
</section>

<section class="roadmap">
	<h2>Where it's headed</h2>
	<p class="subtitle">The project wiki tracks each milestone as an issue. Each milestone lands as one tested commit.</p>
	<div class="roadmap-grid">
		<a class="roadmap-card" href={`${base}docs/project/roadmap/`}>
			<strong>CUE rules</strong><span>Schema, layering, rules verify</span><br /><span class="status done">Done</span>
		</a>
		<a class="roadmap-card" href={`${base}docs/project/roadmap/`}>
			<strong>Scan engine</strong><span>Prefilter, entropy, fingerprints</span><br /><span class="status done">Done</span>
		</a>
		<a class="roadmap-card" href={`${base}docs/project/roadmap/`}>
			<strong>Structure-aware</strong><span>YAML · JSON · .env key paths</span><br /><span class="status done">Done</span>
		</a>
		<a class="roadmap-card" href={`${base}docs/project/roadmap/`}>
			<strong>Git</strong><span>Pre-commit and full history</span><br /><span class="status done">Done</span>
		</a>
		<a class="roadmap-card" href={`${base}docs/project/roadmap/`}>
			<strong>Release</strong><span>SARIF, default rules, CI</span><br /><span class="status">Next</span>
		</a>
		<a class="roadmap-card" href={`${base}docs/project/roadmap/`}>
			<strong>Agent preflight</strong><span>Env vars, SSO caches, sockets</span><br /><span class="status">Planned</span>
		</a>
	</div>
</section>

<section class="callout">
	<div class="callout-inner">
		<h3>Each rule passes its samples before it runs</h3>
		<p>The rules set the quality of a secret scanner. whac does not load a rule that fails its own samples.</p>
		<a href={`${base}docs/getting-started/`} class="btn btn-primary">Get Started</a>
		<a href={`${base}docs/project/decisions/`} class="btn btn-secondary">Design Decisions</a>
	</div>
</section>

<footer class="landing-footer">
	<p>Built by <a href="https://github.com/infrashift">InfraShift</a> &middot; Sibling of <a href="https://infrashift.github.io/vizzini-pr-reviewer/">Vizzini</a></p>
</footer>

<script>
const toggle = document.getElementById('theme-toggle');
const html = document.documentElement;

function setTheme(theme: string) {
	html.setAttribute('data-theme', theme);
	try {
		localStorage.setItem('whac-theme', theme);
	} catch {
		// Storage can be blocked (private windows); the toggle still works for this page view.
	}
	if (toggle) toggle.textContent = theme === 'dark' ? '☾' : '☀';
}

toggle?.addEventListener('click', () => {
	setTheme(html.getAttribute('data-theme') === 'dark' ? 'light' : 'dark');
});

let saved: string | null = null;
try {
	saved = localStorage.getItem('whac-theme');
} catch {
	saved = null;
}
setTheme(saved || 'dark');
</script>

</body>
</html>
